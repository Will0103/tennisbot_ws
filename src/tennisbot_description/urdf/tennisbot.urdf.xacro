<?xml version="1.0"?>

<robot name="tennisbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
     
     <xacro:include filename="common_properties.xacro" />
     <xacro:include filename="tennisbot_gazebo.xacro" />
     <xacro:include filename="tennisbot_ros2_control.xacro" />


<!-- robot descirption -->

    <xacro:property name="base_length" value="0.3" />
    <xacro:property name="base_width" value="0.21" />
    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="wheel_radius" value="0.0325" />
    <xacro:property name="wheel_length" value="0.026" />



    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height / 2.0} " rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <material name="light_yellow" />
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height / 2.0} " rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </collision>
        <xacro:box_inertia m="2.5" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    
    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <joint name="base_leftwheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${-(base_length / 4.0)} ${(base_width / 2.0) + (wheel_length / 2.0)} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
    </link>

    <joint name="base_rightwheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${-(base_length / 4.0)} ${-(base_width / 2.0) - (wheel_length / 2.0)} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>


    <link name="caster_wheel_link">   
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.25" r="${wheel_radius / 2.0}" o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="base_casterwheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length * 3.0 / 8.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

    <link name="IMU_link">
        <visual>
            <origin xyz="0 0 0.01 " rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.02" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.01 " rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.02" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" x="0.08" y="0.08" z="0.02" o_xyz="0 0 0.01" o_rpy="0 0 0" />
    </link>

    <joint name="IMU_joint" type="fixed">
        <parent link="base_link" />
        <child link="IMU_link" />
        <origin xyz="0.07 0 ${base_height}" rpy="0 0 0" />
    </joint>
</robot>